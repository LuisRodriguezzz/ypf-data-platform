# Destino LOCAL. El código de pipelines lee estas variables; nunca URLs hardcodeadas.
LAKEHOUSE_TARGET=local

# Object storage (API S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=lakehouse
S3_SECRET_ACCESS_KEY=lakehouse-dev-2026
S3_REGION=us-east-1
S3_LANDING_BUCKET=landing
S3_LAKEHOUSE_BUCKET=lakehouse

# Catálogo Iceberg
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse

# Metadata (manifiesto de ingesta)
POSTGRES_DSN=postgresql://lakehouse:lakehouse-dev-2026@localhost:5432/lakehouse

# Streaming (perfil `streaming` del compose). Este valor es el del host; los contenedores
# reciben kafka:9092 por variable de entorno y lo pisan.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# MLflow (perfil `mlflow` del compose). Este valor es el del host; el runner recibe
# http://mlflow:5000 por variable de entorno y lo pisa.
MLFLOW_TRACKING_URI=http://localhost:5000

# Fuentes
CKAN_BASE_URL=http://datos.energia.gob.ar
