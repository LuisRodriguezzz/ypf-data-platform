# Copiar a .env (gitignored). Credenciales solo para el entorno local.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse-dev-2026
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse-dev-2026

# Ruta del repo dentro de la máquina de Podman (WSL): Airflow le pide al motor que monte estas
# carpetas en el runner, y el motor las resuelve ahí, no en Windows.
RUNNER_REPO_DIR=/mnt/c/Users/<usuario>/ruta/al/repo
