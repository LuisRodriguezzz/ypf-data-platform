# datos: nunca al repo, se regeneran con el pipeline
data/
*.csv
*.parquet
*.zip
*.xlsx
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
# secretos y entornos
.env
config/*.local.env
# wheel que se sube a artifacts/ (se regenera con `uv build`)
dist/
# terraform
# sin prefijo de ruta: hay dos directorios raiz (infra/terraform y su bootstrap/)
.terraform/
*.tfstate
*.tfstate.backup
# states de los workspaces (terraform.tfstate.d/dev, .../prod) mientras el backend sea local
terraform.tfstate.d/
.terraform.tfstate.lock.info
# plan guardado con -out: es binario y puede traer valores de la cuenta
*.tfplan
# spark / airflow locales
spark-warehouse/
metastore_db/
orchestration/logs/
# dbt: en el runner los artefactos van al volumen (/home/spark/dbt, ver ADR 0009); esto cubre
# una corrida hecha desde el host, que los dejaria al lado del proyecto
pipelines/dbt/target/
pipelines/dbt/logs/
pipelines/dbt/dbt_packages/

# artefacto de Windows por redirecciones
NUL
